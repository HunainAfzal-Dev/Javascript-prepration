name: Daily Auto Commit

on:
  schedule:
    - cron: '30 3 * * *'   # daily (UTC)
  workflow_dispatch:

jobs:
  commit-job:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Make daily change
        run: |
          echo "// Updated on $(date)" >> javascript-prepration/index.js

      - name: Commit changes
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"
          git add javascript-prepration/index.js
          git commit -m "Daily automated update" || echo "No changes to commit"

      - name: Push changes
        run: |
          git push
